plot.title = element_text(size = 14, face = "bold"))
emotion_normalized <- emotion_normalized %>%
mutate(freq_pct = freq * 100)
ggplot(emotion_normalized, aes(x = chapter, y = sentiment, fill = freq_pct)) +
geom_tile(color = "white") +
scale_fill_viridis_c(option = "C", name = "Emotion %") +
labs(title = "Normalized Emotion Heatmap Across Chapters",
x = "Chapter", y = "Emotion") +
theme_minimal()
emotion_normalized <- emotion_normalized %>%
mutate(freq_pct = freq * 10)
ggplot(emotion_normalized, aes(x = chapter, y = sentiment, fill = freq_pct)) +
geom_tile(color = "white") +
scale_fill_viridis_c(option = "C", name = "Emotion %") +
labs(title = "Normalized Emotion Heatmap Across Chapters",
x = "Chapter", y = "Emotion") +
theme_minimal()
emotion_normalized <- emotion_normalized %>%
mutate(freq_pct = freq * 1)
ggplot(emotion_normalized, aes(x = chapter, y = sentiment, fill = freq_pct)) +
